NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=atlasdev
GROBID_BASE_URL=http://localhost:8070
DATA_DIR=./data
ARXIV_CATEGORIES=cs.RO,cs.LG,cs.AI
S2_API_BASE=https://api.semanticscholar.org/graph/v1
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# API Key 仅从系统环境变量 DASHSCOPE_API_KEY 读取
LLM_MODEL=qwen3.8-flash
# Research profile verified with the fixed Qwen snapshot. Enabling calls still
# requires deciding which materials may leave the local machine.
RESEARCH_MODEL_ENABLED=false
RESEARCH_MODEL_RESPONSE_FORMAT=json_schema
RESEARCH_MODEL_SCHEMA_REQUIRE_ALL=false
RESEARCH_MODEL_ENABLE_THINKING=false
RESEARCH_MODEL_MAX_OUTPUT_TOKENS=8192
LLM_EMBED_MODEL=text-embedding-v4
LLM_TIMEOUT_SECONDS=120

# Account email recovery. Existing accounts can bind and verify an email in settings.
# Keep real SMTP credentials in environment variables, not source control.
REGISTRATION_ENABLED=true
AUTH_PUBLIC_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
# starttls (587) or ssl (465). plain is accepted only for loopback test servers.
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=10
PASSWORD_RESET_MINUTES=30
